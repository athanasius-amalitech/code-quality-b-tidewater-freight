<?xml version="1.0"?>
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
    Style gate for the AmaliTech Coding Standards (Java Edition).
    Each rule names the section of the standard it enforces.
    Layout (indentation, wrapping, blank lines) is left to the shared formatter profile:
    https://github.com/athanasius-amalitech/vscode-java-formatter
-->
<module name="Checker">
    <property name="severity" value="error"/>

    <!-- Tests use literal example values on purpose: that is what makes them readable -->
    <module name="SuppressionSingleFilter">
        <property name="files" value="[\\/]src[\\/]test[\\/]"/>
        <property name="checks" value="MagicNumber"/>
    </module>

    <!-- §11.1 Column limit 100 characters -->
    <module name="LineLength">
        <property name="max" value="100"/>
    </module>
    <module name="NewlineAtEndOfFile"/>

    <module name="TreeWalker">
        <!-- §11.1 One top-level class per file, named after the class -->
        <module name="OneTopLevelClass"/>
        <module name="OuterTypeFilename"/>

        <!-- §11.1 No wildcard imports; static and other imports in two ASCII-sorted blocks -->
        <module name="AvoidStarImport"/>
        <module name="UnusedImports"/>
        <module name="RedundantImport"/>
        <module name="CustomImportOrder">
            <property name="customImportOrderRules" value="STATIC###THIRD_PARTY_PACKAGE"/>
            <property name="sortImportsInGroupAlphabetically" value="true"/>
            <property name="separateLineBetweenGroups" value="true"/>
        </module>

        <!-- §11.1 Braces always, opening brace at end of line -->
        <module name="NeedBraces"/>
        <module name="LeftCurly"/>

        <!-- §11.1 One variable per declaration -->
        <module name="MultipleVariableDeclarations"/>

        <!-- §3 Naming -->
        <module name="PackageName"/>
        <module name="TypeName"/>
        <module name="MethodName"/>
        <module name="MemberName"/>
        <module name="ParameterName"/>
        <module name="LocalVariableName"/>
        <module name="ConstantName"/>

        <!-- §3.4 Name numbers as constants -->
        <module name="MagicNumber"/>

        <!-- §4.1 Methods rarely longer than 20 lines -->
        <module name="MethodLength">
            <property name="max" value="20"/>
            <property name="countEmpty" value="false"/>
        </module>

        <!-- §4.3 Few arguments: three at most -->
        <module name="ParameterNumber">
            <property name="max" value="3"/>
        </module>

        <!-- §6.1 Never swallow exceptions; never catch everything (the original catch-all bug) -->
        <module name="EmptyCatchBlock"/>
        <module name="IllegalCatch"/>

        <!-- §7.7 Horizontal spacing -->
        <module name="WhitespaceAround"/>
        <module name="WhitespaceAfter"/>
        <module name="MethodParamPad"/>
    </module>
</module>
